[node name="TimerText" type="Label" parent="CanvasLayer/BoxContainer2"]
layout_mode = 2
theme_override_font_sizes/font_size = 92
text = "00:00"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Systems" type="Node" parent="."]

[node name="GameManager" type="Node" parent="Systems" node_paths=PackedStringArray("timer", "timerText", "game_winUI")]
script = ExtResource("10_28xvs")
timer = NodePath("Timer")
timerText = NodePath("../../CanvasLayer/BoxContainer2/TimerText")
game_winUI = NodePath("../../CanvasLayer/GameWin")

[node name="Timer" type="Timer" parent="Systems/GameManager"]
wait_time = 5.0
one_shot = true

[connection signal="timeout" from="Systems/GameManager/Timer" to="Systems/GameManager" method="_on_timer_timeout"]

[editable path="Entity/enemy"]
